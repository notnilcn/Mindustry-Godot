[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" path="res://scenes/ui/dialogs/mind_dialog_base.tscn" id="1_base"]
[ext_resource type="Script" path="res://ui/dialogs/custom_game_dialog.gd" id="2_script"]

[node name="CustomGameDialog" instance=ExtResource("1_base")]
script = ExtResource("2_script")
