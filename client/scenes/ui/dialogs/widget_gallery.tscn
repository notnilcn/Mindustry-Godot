; SPDX-License-Identifier: GPL-3.0-only
;
; Dev-only widget gallery (plan 14 §5 M1 verification). Static frame mirrors
; about_dialog.tscn; the widget row content is code-built (data-driven gallery).
;
; Ported from Mindustry (https://github.com/Anuken/Mindustry) — GPL-3.0.

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/dialogs/widget_gallery.gd" id="1_gallery"]

[node name="WidgetGallery" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_gallery")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2
custom_minimum_size = Vector2(560, 400)
theme_type_variation = &"defaultDialog"

[node name="Layout" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Panel/Layout"]
layout_mode = 2
text = "Widget Gallery"
horizontal_alignment = 1

[node name="Body" type="ScrollContainer" parent="Center/Panel/Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Center/Panel/Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Buttons" type="HBoxContainer" parent="Center/Panel/Layout"]
layout_mode = 2
alignment = 1
