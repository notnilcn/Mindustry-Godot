;
; PlanetDialog (plan 14 M5). Inherits the shared dialog frame; the planet rail
; and sector grid are built by planet_dialog.gd from the plan-12 read models.
;
; Ported from Mindustry (https://github.com/Anuken/Mindustry) — GPL-3.0.

[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" path="res://scenes/ui/dialogs/mind_dialog_base.tscn" id="1_base"]
[ext_resource type="Script" path="res://ui/dialogs/planet_dialog.gd" id="2_script"]

[node name="PlanetDialog" instance=ExtResource("1_base")]
script = ExtResource("2_script")
