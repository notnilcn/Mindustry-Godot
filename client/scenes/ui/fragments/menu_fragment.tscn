; SPDX-License-Identifier: GPL-3.0-only
;
; Menu fragment (plan 14 §3.5, M3): static desktop button set. Button text is
; replaced with bundle strings by menu_fragment.gd; mobile rebuilds the set as a
; `MindMobileButton` grid (code-instantiated).
;
; Ported from Mindustry (https://github.com/Anuken/Mindustry) — GPL-3.0.
; Source: core/src/mindustry/ui/fragments/MenuFragment.java

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/fragments/menu_fragment.gd" id="1_menu"]

[node name="MenuFragment" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_menu")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2
theme_type_variation = &"defaultDialog"

[node name="Layout" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Panel/Layout"]
layout_mode = 2
text = "Mindustry-Godot"
horizontal_alignment = 1

[node name="Version" type="Label" parent="Center/Panel/Layout"]
layout_mode = 2
text = "dev"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)

[node name="Buttons" type="VBoxContainer" parent="Center/Panel/Layout"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PlayButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "Play"

[node name="CampaignButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "Campaign"

[node name="DatabaseButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "Database"

[node name="EditorButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "Editor"

[node name="ModsButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "Mods"

[node name="SettingsButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "Settings"

[node name="LanguageButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "Language"

[node name="DiscordButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "Discord"

[node name="AboutButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "About"

[node name="QuitButton" type="Button" parent="Center/Panel/Layout/Buttons"]
layout_mode = 2
theme_type_variation = &"defaultt"
text = "Quit"
