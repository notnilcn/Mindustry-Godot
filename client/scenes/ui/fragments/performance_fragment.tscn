; SPDX-License-Identifier: GPL-3.0-only
;
; Performance overlay (plan 14 §3.5/M2). Read-only Godot `Performance` monitors.
;
; Ported from Mindustry (https://github.com/Anuken/Mindustry) — GPL-3.0.

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/fragments/performance_fragment.gd" id="1_perf"]

[node name="PerformanceFragment" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_perf")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -320.0
offset_top = 4.0
offset_right = -4.0
offset_bottom = 40.0
grow_horizontal = 0
theme_type_variation = &"defaultDialog"

[node name="Label" type="Label" parent="Panel"]
layout_mode = 2
text = "fps -"
horizontal_alignment = 2
