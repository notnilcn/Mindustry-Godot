;
; Placement fragment (plan 14 §3.5, M4): static palette panel (search / category
; rail / block grid). The rail and grid are populated by placement_fragment.gd.
;
; Ported from Mindustry (https://github.com/Anuken/Mindustry) — GPL-3.0.
; Source: core/src/mindustry/ui/fragments/PlacementFragment.java

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/fragments/placement_fragment.gd" id="1_placement"]

[node name="PlacementFragment" type="Control"]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -620.0
offset_top = -120.0
grow_horizontal = 0
grow_vertical = 0
mouse_filter = 1
script = ExtResource("1_placement")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"defaultPane"

[node name="Layout" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Search" type="LineEdit" parent="Panel/Layout"]
layout_mode = 2

[node name="Categories" type="HBoxContainer" parent="Panel/Layout"]
layout_mode = 2

[node name="Blocks" type="GridContainer" parent="Panel/Layout"]
layout_mode = 2
columns = 10
size_flags_vertical = 3
