; SPDX-License-Identifier: GPL-3.0-only
;
; UI root of the plan-14 client UI (plan 14 §3.2). Inserted under
; `Spine/Ui/UiRoot`; groups map to Mindustry's `UI.menuGroup`/`hudGroup` plus
; the dialog/overlay/loading layers. Static layer scaffolds only; dialogs and
; fragments are manifest-instantiated by ui_root.gd (code-instantiated).
;
; Ported from Mindustry (https://github.com/Anuken/Mindustry) — GPL-3.0.

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/ui_root.gd" id="1_root"]

[node name="UiRoot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_root")

[node name="MenuGroup" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="HudGroup" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="DialogLayer" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="OverlayLayer" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="LoadingLayer" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
