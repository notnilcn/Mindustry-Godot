# Build outputs and caches
client/.godot/
# Keep the Godot import guard tracked; everything else under bin/ is generated.
client/bin/*
!client/bin/.gdignore
client/rust/target/
server/spacetimedb/target/

# Plan 03 asset pipeline outputs (03_ASSETS_IMPLEMENTATION_PLAN.md §6.9)
build/
assets/sprites/sprites*.png
assets/sprites/sprites.atlas.json
assets/sprites/fallback/
assets/sprites/block_colors.png
assets/icons/icon_codes.json
assets/sounds.index.json
assets/locales
assets/shaders/godot/
assets/shaders/shader.index.json

# Generated scenario mirror (canonical files live in scenarios/)
client/scenarios/

# Generated build report (plan 22 M0; tools/version.sh)
client/assets/version.properties

# Godot Android export output (merged from the legacy client/.gitignore)
client/android/

# Logs and local state
*.log
last_log.txt
out/

# Editor workspace state
.obsidian/
*.swp

# OS shell metadata (junk inside vendored addon trees)
desktop.ini
.DS_Store

# SpacetimeDB token/identity files
client/**/identity/

# Python bytecode
__pycache__/
*.pyc

# Windows temp droppings committed inside vendored addon bin dirs
*.TMP

# Local agent/orchestrator session state (not part of the project)
session.json
.kimi-code/

# Per-session parity runtime (tools/parity-session.sh): XDG data/cache, pids,
# MCP shim, Godot shader caches and identity tokens. Regenerated on start.
.opencode/parity-session/

# OpenCode loop/goal plugin runtime state
.opencode/opencode-loop/
.opencode/goals/
.opencode/goal-sequences/
.opencode/goal-locks/

# Parity run artifacts + persistent Java reference data dir
runs/
parity-java-home/
# Shared ledger claim lock (parity-session.sh also adds it to .git/info/exclude)
parity-ledger.json.lock

screenshots_for_ai/
# Vars.checkLaunch marker (Vars.java:398-408); never commit a crash marker
client/launchid.dat
