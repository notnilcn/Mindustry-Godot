#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
#
# PATH shim: pin open-godot-mcp to this parity loop's editor bridge port,
# displays and isolated Godot user-data dirs. The server (and any standalone
# game it spawns) gets the loop's weston/Wayland socket so rendering stays on
# the GPU; DISPLAY is kept for X11-only tooling.
set -euo pipefail

self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
clean_path="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vFx "$self_dir" | paste -sd: -)"
real="${OPEN_GODOT_MCP_REAL:-$(PATH="$clean_path" command -v open-godot-mcp || true)}"
if [ -z "$real" ]; then
  echo "parity-loop shim: open-godot-mcp not found on PATH" >&2
  exit 127
fi

# If only the loop id was inherited (manual launch), derive the full manifest.
if [ -n "${PARITY_LOOP:-}" ]; then
  # shellcheck source=../lib/loop-vars.sh
  . "$self_dir/../lib/loop-vars.sh"
  parity_loop_vars "$PARITY_LOOP"
  # The displays must exist before the bridge spawns a standalone game.
  parity_ensure_display
  parity_ensure_wayland || true
fi

env_args=()
[ -n "${PARITY_DISPLAY:-}" ] && env_args+=("DISPLAY=$PARITY_DISPLAY")
if [ -n "${PARITY_WAYLAND_SOCKET:-}" ] && [ -S "${PARITY_WAYLAND_DIR:-}/$PARITY_WAYLAND_SOCKET" ]; then
  env_args+=("WAYLAND_DISPLAY=$PARITY_WAYLAND_SOCKET" "XDG_RUNTIME_DIR=$PARITY_WAYLAND_DIR")
fi
[ -n "${PARITY_BRIDGE_PORT:-}" ] && env_args+=("OPEN_GODOT_MCP_PORT=$PARITY_BRIDGE_PORT")
if [ -n "${PARITY_LOOP_DIR:-}" ]; then
  mkdir -p "$PARITY_LOOP_DIR/xdg-data" "$PARITY_LOOP_DIR/xdg-config" "$PARITY_LOOP_DIR/xdg-cache"
  env_args+=(
    "XDG_DATA_HOME=$PARITY_LOOP_DIR/xdg-data"
    "XDG_CONFIG_HOME=$PARITY_LOOP_DIR/xdg-config"
    "XDG_CACHE_HOME=$PARITY_LOOP_DIR/xdg-cache"
  )
fi
exec env "${env_args[@]}" "$real" "$@"
