#!/usr/bin/env bash
# Session 5 MCP shim (generated by tools/parity-session.sh): pin
# open-godot-mcp to bridge port 7010 and display :14.
set -euo pipefail
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
clean_path="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vFx "$self_dir" | paste -sd: -)"
real="${OPEN_GODOT_MCP_REAL:-$(PATH="$clean_path" command -v open-godot-mcp || true)}"
if [ -z "$real" ]; then
  echo "parity-session shim: open-godot-mcp not found on PATH" >&2
  exit 127
fi
exec env DISPLAY=":14" OPEN_GODOT_MCP_PORT="7010" \
  XDG_DATA_HOME="/home/clintonnguyen/g/code_examples/Mindustry-Godot/.opencode/parity-session/session-5/xdg-data" XDG_CONFIG_HOME="/home/clintonnguyen/g/code_examples/Mindustry-Godot/.opencode/parity-session/session-5/xdg-config" \
  XDG_CACHE_HOME="/home/clintonnguyen/g/code_examples/Mindustry-Godot/.opencode/parity-session/session-5/xdg-cache" "$real" "$@"
